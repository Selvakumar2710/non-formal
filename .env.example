# Clinic Management System Environment Configuration

# Server Port (default: 3000, or dynamically assigned by host)
PORT=3000
NODE_ENV=production

# --- Google Gemini AI API Configuration ---
# Optional: Enables natural language clinical intelligence and copilot queries.
# If omitted or rate-limited, the system automatically falls back to grounded operational analytics.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase / PostgreSQL Database Configuration ---
# You can connect via direct PostgreSQL connection pooler OR Supabase REST client:

# Option A: Direct PostgreSQL URI (Port 5432 or 6543)
# Find in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option B: Supabase REST API & Keys
# Find in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Secret service_role key (bypasses RLS for backend API operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Public anon key
SUPABASE_ANON_KEY=your_supabase_anon_key_here
